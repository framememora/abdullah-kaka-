# ─────────────────────────────────────────────────────────────
# Copy this file to ".env" and fill it in. Never commit ".env".
# ─────────────────────────────────────────────────────────────

# ── Shop identity (shown on the rating page) ────────────────
SHOP_NAME=Your Shop Name
SHOP_TAGLINE=How was your visit today?
SHOP_LOGO_URL=
BRAND_COLOR=#1a73e8

# ── Google review destination ───────────────────────────────
# Easiest: find your Place ID at
#   https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACE_ID=
# Optional: paste a full review link instead (this overrides PLACE_ID).
# e.g. https://g.page/r/XXXXXXXXXXXX/review
GOOGLE_REVIEW_URL=

# ── Funnel behaviour ────────────────────────────────────────
# Ratings >= this number are sent to Google. Must be 1..5
REDIRECT_THRESHOLD=4

# REVIEW_MODE:
#   gated     = only ratings >= threshold ever see the Google link.
#               NOTE: this is "review gating" and breaks Google's review policy.
#   compliant = low ratings see the private form first, then are still offered
#               a Google link on the thank-you screen.
REVIEW_MODE=gated

# ── WhatsApp notifications (Meta Cloud API) ─────────────────
# WHATSAPP_PROVIDER: none | meta
# Keep this on "none" until your message template is approved by Meta.
# With "none", alerts print to the server console and everything else still works.
WHATSAPP_PROVIDER=none

# Owner's WhatsApp number, E.164. The "+" is optional. e.g. +923001234567
WHATSAPP_TO=

# From the WhatsApp > API Setup page of your Meta app.
META_PHONE_NUMBER_ID=

# IMPORTANT: the token shown on the API Setup page expires in 24 hours.
# Generate a permanent one from Business Settings > System Users instead.
META_ACCESS_TOKEN=

# Business-initiated WhatsApp messages must use a pre-approved template.
# Create one (category: Utility) with a body of exactly three variables, e.g.
#   New {{1}}-star feedback: "{{2}}" - contact: {{3}}
# then put its name here.
META_TEMPLATE_NAME=low_rating_alert
META_TEMPLATE_LANG=en

# ── Server ──────────────────────────────────────────────────
PORT=3000

# Password for the /admin dashboard. You MUST change this.
ADMIN_TOKEN=change-me-please

# Public base URL. Used by "npm run qr" to build the QR code.
# This must be the URL customers can actually reach from their phones.
# For the static (GitHub Pages) deployment this is https://<user>.github.io/<repo>/
# "npm run qr" refuses to run against localhost or a LAN address like 192.168.x.x.
PUBLIC_URL=http://localhost:3000

# ── Static deployment (GitHub Pages) ─────────────────────────────────────────
# The Google Apps Script web app that stores feedback and emails the owner. It
# replaces the Express backend when the site is served as static files.
# Deploy it (see STATIC_SETUP.md), then paste the /exec URL here.
# Required by "npm run build"; not used by "npm start".
APPS_SCRIPT_URL=
